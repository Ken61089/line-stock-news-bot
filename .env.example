# ====== 把這個檔複製成 .env(本機測試用),或在 Zeabur 後台逐項填入環境變數 ======

# --- LINE ---
# LINE Developers 後台 → Messaging API channel 取得
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
# 只允許你本人使用:填你的 LINE user id(傳「id」給機器人可查)。留空 = 不限制(不建議)。
LINE_ALLOWED_USER_ID=

# --- Claude(透過 Zeabur AI Hub,OpenAI 相容)---
OPENAI_BASE_URL=https://hnd1.aihub.zeabur.ai/v1
OPENAI_API_KEY=sk-your-aihub-key
AI_MODEL=claude-sonnet-4-5

# --- Google Sheets ---
# 已淘汰:機器人所有資料改存 Notion,執行時不再需要 Google Sheet/憑證。
# (只有「一次性把舊 Sheet 歷史資料匯入 Notion」的離線腳本才需要 credentials.json,平時可不設)

# 服務監聽的埠口(Zeabur 會自動帶入 PORT,本機可不設,預設 8080)
# PORT=8080

# --- 抓連結全文(功能1)---
# 不設也能運作:預設用 trafilatura(免費、零設定)抓新聞正文。
# 若有 Firecrawl 金鑰,會優先用它(更會處理動態/難搞網站)。
# FIRECRAWL_API_KEY=fc-your-key
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# MAX_ARTICLE_CHARS=8000     # 抓回的正文字數上限
# MAX_CONTENT_CHARS=8000     # 送進 AI 分析的內文字數上限

# --- Notion(時程指令 + 5 類新聞正本;已從 Google Sheet 轉到 Notion)---
# Notion internal integration 密鑰:https://www.notion.so/my-integrations 建立後複製,
# 並到「股票投資大腦」頁面 → 右上 ... → 連線 → 加入該 integration(才有寫入權)。
# 個股新聞/產業新聞/個股產業報告 → 寫進「新聞與時程動態庫」並關聯個股+概念;
# 全球局勢 → 全球局勢動態庫;知識 → 知識補充庫;概念自動找/建並掛到個股主表。
NOTION_TOKEN=
# 以下 data source id 已內建正式值,通常不用改:
# NOTION_TIMELINE_DS=388da86b-7f8b-8139-ad5a-000b9477f4ef    # 新聞與時程動態庫
# NOTION_STOCK_DS=388da86b-7f8b-817c-93ca-000b5553ac22       # 個股主表
# NOTION_CONCEPT_DS=388da86b-7f8b-8177-8d81-000badfe5200     # 概念族群庫
# NOTION_GLOBAL_DS=36694cc2-76ec-469e-9e78-1d0df333d79a      # 全球局勢動態庫
# NOTION_KNOWLEDGE_DS=517dd7f8-6804-4048-bd0c-529a8cbe8b1a   # 知識補充庫
# NOTION_EPS_DS=273aa9fb-74ab-4a47-aa7e-9cb1b076c7d5         # 財報 EPS 庫(一檔一季一列)
# NOTION_VERSION=2025-09-03

# 時程指令若個股主表查無該檔 → 自動新增再關聯(預設開;設 0 關閉,改回只建事件不關聯)
# AUTO_CREATE_STOCK=1

# --- Notion 行事曆 → LINE 群組定時推播 ---
# 推播目標:把機器人拉進 LINE 群組後,在群裡傳「id」給機器人,取得 group id 貼在這裡。
# (也可填個人 user id 推給自己測試)
LINE_NOTIFY_TARGET_ID=
# 以下為預設,通常不用改(台灣時間):
# NOTIFY_DAILY_TIME=07:00     # 每天推「當日」事件的時刻
# NOTIFY_TOMORROW_TIME=21:00  # 每天推「明日」事件的時刻
# NOTIFY_WEEKLY_TIME=21:00    # 每週推「下週」彙整的時刻
# NOTIFY_WEEKLY_DOW=6         # 每週推播星期:0=一 1=二 … 6=日
# NOTIFY_EXCLUDE_TYPES=       # 不想推播的事件類型(逗號分隔),例如:盤後隨筆,其他
# ENABLE_SCHEDULER=1          # 設 0 可完全停用內建排程
# FETCH_EARNINGS_TIME=06:30   # 每天自動抓法說會的時刻(排在推播前)
# EARNINGS_LEAD_DAYS=2        # 法說會提前預告天數:2=當天+前2天共 3 個早上都在 07:00 提醒倒數

# --- 反向查詢(功能2;已改讀 Notion)---
# QUERY_ROWS_PER_TAB=80      # 每個 Notion 庫取最近幾筆供查詢
# QUERY_CHAR_BUDGET=15000    # 送進 AI 的資料總字元上限

# --- 概念(已全部走 Notion,不再用 Google Sheet)---
# 概念↔個股存 Notion 個股主表「隸屬概念」+ 概念族群庫;
# AI 標概念的白名單 = 內建種子 ∪ Notion 概念族群庫現有概念(隨新增資料自動成長)。
# 下面兩個舊 Sheet 分頁變數已停用(保留僅為相容,程式不再讀寫):
# CONCEPT_MASTER_TAB=概念股主表
# CONCEPT_LIST_TAB=概念清單

# NOTION_ALERT_DS=aec23e1e-4782-4346-b997-9283f5ae7138   # 事件提醒庫
# ALERT_DAILY_CAP=5            # 盤中提醒每日推播上限(守 LINE 免費額度)
